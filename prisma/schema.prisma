// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id                  Int       @id @default(autoincrement())
  name                String?
  email               String    @unique @db.VarChar(191)
  phone               String?
  timezone            String?
  password            String
  roleId              Int
  role                Role      @relation(fields: [roleId], references: [id])
  accreditationStatus String    @default("individual")
  twoFactorEnabled    Boolean   @default(true)
  otpCode             String?
  otpExpiry           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  lastLoginAt        DateTime?
  userCode           String?   @unique @db.VarChar(20)
  status             Int?      @default(1) // active inactive
  verificationStatus Int?      @default(0) // 
  settings           Json? // noti

  kyc                 Kyc?
  activityLogs       ActivityLog[]
}

model RegistrationOtp {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  otpCode   String
  otpExpiry DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Kyc {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])

  // ===== Progress =====
  currentStep           Int    @default(1)
  status                String @default("draft")
  identityStatus        String @default("pending")
  accreditationStatus   String @default("pending")
  
  identityVerifiedAt    DateTime?
  submittedAt           DateTime?


  // ===== STEP 1: Personal Info =====
  firstName   String?
  lastName    String?
  middleName  String?
  dateOfBirth DateTime?

  nationality String?
  country     String?
  address     String?
  city        String?
  state       String?
  postalCode  String?
  phone       String?

  // ===== STEP 2: Identity =====
  documentType String?
  // passport | drivers | national

  // ===== STEP 3: Accreditation =====
  entityType String? // individual | family | institution | advisor

  // Individual
  individualCriteria String? // income | networth | professional

  // Entity
  entityName      String?
  entityLegalType String?
  formationDate   DateTime?
  jurisdiction    String?
  totalAssets     String?

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  KycDocument KycDocument[]
}

model KycDocument {
  id    Int @id @default(autoincrement())
  kycId Int
  kyc   Kyc @relation(fields: [kycId], references: [id])

  step Int
  // 2 = ID document
  // 3 = Accreditation document

  fileName String
  fileUrl  String
  fileType String // image | pdf
  fileSize Int

  createdAt DateTime @default(now())
}

model ActivityLog {
  id Int @id @default(autoincrement())

  userId Int?
  user   User? @relation(fields: [userId], references: [id])

  action     String @db.VarChar(50) // LOGIN, APPROVE_KYC, SUBSCRIPTION, UPLOAD_DOC...
  entityType Json? // Investor, KYC, Subscription, Document

  details   String?
  location  String?
  ipAddress String?

  createdAt DateTime @default(now())

  @@index([userId])
}
